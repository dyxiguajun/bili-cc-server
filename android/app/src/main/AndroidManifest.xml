<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>
    <application
        android:name=".BiliApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/bili_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.BiliCC">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_name"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ShareWindowActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.BiliCC.Share" />
        <service
            android:name=".ShareJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
