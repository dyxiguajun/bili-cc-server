<resources>
    <style name="Theme.BiliCC.Base" parent="android:style/Theme.Material.Light.NoActionBar" />
    <style name="Theme.BiliCC" parent="Theme.BiliCC.Base">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/bili_accent</item>
        <item name="android:windowBackground">@color/bili_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/bili_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/bili_light_system_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.BiliCC.Share" parent="Theme.BiliCC">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
