{
  "manifest_version": 3,
  "name": "Bili CC",
  "description": "点击工具栏图标，提取、预览和复制当前 B 站视频的字幕。",
  "version": "2.4.0",
  "author": "XiGua",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "offscreen"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "用 Bili CC 提取字幕",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "key": "",
  "optional_host_permissions": [
    "https://*/*"
  ],
  "minimum_chrome_version": "116"
}
